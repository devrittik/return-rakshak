# ── Database ────────────────────────────────────────────────────────────────
# LOCAL MODE (default): a SQLite file outside public/. Never use this on Vercel.
# DATABASE_URL=file:./data/returnrakshak.db

# HOSTED MODE: Turso / libSQL. When set, these take precedence over DATABASE_URL.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# ── AI provider ─────────────────────────────────────────────────────────────
# mock   = offline deterministic extractor (default, no model, no network)
# openai-compatible = any open-weight server exposing POST /v1/chat/completions
#                     (llama.cpp `llama-server`, Ollama, vLLM, LM Studio, ...)
AI_PROVIDER=mock

# Both AI_BASE_URL and AI_MODEL are required. If either is missing, extraction
# fails as "not configured" and manual entry stays available — it does not
# silently switch back to the mock. No model is downloaded.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_MODEL=qwen2.5-7b-instruct
# AI_API_KEY=
# AI_TIMEOUT_MS=30000

# ── Local owner (single-user mode until auth lands) ─────────────────────────
# RR_LOCAL_USER_EMAIL=local@returnrakshak.invalid

# ── OCR (fallback for scans and images) ─────────────────────────────────────
# Tesseract.js fetches traineddata on first use unless a cache is present.
# TESSERACT_LANG=eng
# TESSERACT_CACHE_PATH=./data/tesseract-cache
